+++ b/e2e/journey.spec.ts
@@ -0,0 +1,44 @@
+import { expect, test } from "@playwright/test";
+
+const EMAIL = `e2e-${Date.now()}@test.local`;
+
+/**
+ * Core journey: register → book an artist → see the booking in the dashboard.
+ * Uses a fresh email per run; the SQLite DB persists between runs (data/ is
+ * gitignored and CI uses a fresh checkout, so this is safe).
+ */
+test("register, book an artist, and see the booking in the dashboard", async ({ page }) => {
+  // Register
+  await page.goto("/register");
+  await page.getByLabel("Full name").fill("E2E User");
+  await page.getByLabel("Email Address").fill(EMAIL);
+  await page.getByLabel("Password", { exact: true }).fill("password123");
+  await page.getByRole("button", { name: "Sign Up Free" }).click();
+
+  // Redirected to dashboard after registration
+  await expect(page).toHaveURL(/\/dashboard/);
+  await expect(page.getByRole("heading", { name: /Hi, E2E/ })).toBeVisible();
+
+  // Browse to an artist and request a booking
+  await page.goto("/artists/aisha-azman");
+  await page.getByRole("link", { name: "Request Booking" }).click();
+
+  await page.getByLabel("Service").selectOption("Solemnization Makeup");
+  await page.getByLabel("Event type").selectOption("Solemnization");
+  await page.getByLabel("Date").fill("2026-09-15");
+  await page.getByLabel("Preferred time").selectOption("10:00 AM");
+  await page.getByRole("button", { name: "Confirm Booking Request" }).click();
+
+  await expect(page.getByRole("heading", { name: "Booking requested!" })).toBeVisible();
+
+  // The booking shows up on the dashboard
+  await page.goto("/dashboard");
+  await expect(page.getByText("Aisha Azman")).toBeVisible();
+  await expect(page.getByText("Solemnization Makeup")).toBeVisible();
+  await expect(page.getByText("requested")).toBeVisible();
+});
+
+test("protected pages redirect unauthenticated users to login", async ({ page }) => {
+  await page.goto("/dashboard");
+  await expect(page).toHaveURL(/\/login\?redirect=%2Fdashboard/);
+});
