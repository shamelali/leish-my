new file mode 100644
index 0000000..34f2138
--- /dev/null
+++ b/scripts/migrate.ts
@@ -0,0 +1,33 @@
+/**
+ * Standalone migration runner.
+ *
+ * Usage:
+ *   DATABASE_URL=<postgres connection string> npm run db:migrate
+ *
+ * Applies the schema (tables + indexes) to the target database. The app
+ * also runs this lazily on first query when DATABASE_URL is set, so this
+ * script is mainly for explicit migrations / CI / local provisioning.
+ */
+import { getDb, closeDb, isPostgres } from "../src/server/db.ts";
+
+async function main() {
+  if (!isPostgres()) {
+    console.error(
+      "DATABASE_URL is not set. Set it to a PostgreSQL connection string (e.g. Neon):",
+      "DATABASE_URL=postgresql://user:pass@host/db?sslmode=require npm run db:migrate",
+    );
+    process.exit(1);
+  }
+
+  console.log("Migrating PostgreSQL schema…");
+  const db = getDb();
+  // Force the lazy migration to complete, then verify with a trivial query.
+  await db.prepare("SELECT 1 AS ok").get();
+  console.log("✓ Schema applied (users, bookings, quotations, payments, messages, …)");
+  await closeDb();
+}
+
+main().catch((err) => {
+  console.error("Migration failed:", err?.message ?? err);
+  process.exit(1);
+});
